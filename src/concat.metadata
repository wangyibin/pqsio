{'format-version': '0.2.0',
 'format-url': 'https://github.com/wangyibin/CPhasing',
 'creation_time': '{creation_time}',
 'is_pqs': True,
 'format': 'concat',
 'record_type': 'porec_alignment',
 'chunksize': {chunksize},
 'partition_key': 'read_idx',
 'read_idx_scope': 'global',
 'complete_groups': True,
 'is_with_mapq': True,
 'q1_min_mapq': 1,
 'columns': ['read_idx', 'read_length', 'read_start', 'read_end',
             'strand', 'chrom', 'start', 'end',
             'mapping_quality', 'identity', 'filter_reason'],
 'dtypes': {'read_idx': 'uint64',
             'read_length': 'uint32',
             'read_start': 'uint32',
             'read_end': 'uint32',
             'strand': 'U',
             'chrom': 'U',
             'start': '{position_dtype}',
             'end': '{position_dtype}',
             'mapping_quality': 'uint8',
             'identity': 'float32',
             'filter_reason': 'U'},
 'schema': {'read_idx': UInt64,
            'read_length': UInt32,
            'read_start': UInt32,
            'read_end': UInt32,
            'strand': Categorical,
            'chrom': Categorical,
            'start': {position_type},
            'end': {position_type},
            'mapping_quality': UInt8,
            'identity': pl.Float32,
            'filter_reason': Categorical}}
